# ====================================================================
# Hermes Agent 設定範本（實際檔案位置：%USERPROFILE%\.hermes\.env）
# ====================================================================
# 注意：
#  - 這是「範本」，請勿把真實 token 提交到 git。
#  - 正常情況用 `hermes gateway setup` / `hermes model` 精靈設定即可，
#    精靈會自動寫入 ~/.hermes/.env，不需要手動編輯本檔。
#  - 下面只列出 Discord 與常見模型供應商的關鍵變數供參考。
# ====================================================================

# ---- Discord（用 Bot Token，不是 webhook）----
DISCORD_BOT_TOKEN=__在此貼上你的_Discord_Bot_Token__
DISCORD_ALLOWED_USERS=__你的Discord使用者ID__          # 多個用逗號分隔；務必設定，否則預設拒絕所有人
# DISCORD_REQUIRE_MENTION=true                          # 伺服器頻道是否需要 @ 提及（預設 true）
# DISCORD_FREE_RESPONSE_CHANNELS=__頻道ID1,頻道ID2__    # 這些頻道不需 @ 也會回應

# ---- 模型供應商（擇一；建議用精靈設定）----
# NousResearch Portal:
# NOUS_PORTAL_API_KEY=__你的金鑰__
# OpenRouter:
# OPENROUTER_API_KEY=__你的金鑰__
# OpenAI:
# OPENAI_API_KEY=__你的金鑰__
